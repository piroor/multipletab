{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "3.2.4",
  "author": "YUKI \"Piro\" Hiroshi",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "contextualIdentities",
    "cookies",
    "menus",
    "menus.overrideContext",
    "notifications",
    "storage",
    "tabs"
  ],
  "optional_permissions": [
    "<all_urls>",
    "bookmarks",
    "browserSettings"
  ],
  "icons": {
    "16": "/resources/16x16.svg#default-proton",
    "20": "/resources/20x20.svg#default-proton",
    "24": "/resources/24x24.svg#default-proton"
  },
  "background": {
    "page": "/background/background.html"
  },
  "browser_action": {
    "default_title": "__MSG_panelTitle__",
    "default_icon": {
      "16": "/resources/16x16.svg#toolbar-proton",
      "20": "/resources/20x20.svg#toolbar-proton",
      "24": "/resources/24x24.svg#toolbar-proton"
    },
    "browser_style": true
  },
  "commands": {
    "invertSelection": {
      "description": "__MSG_command_invertSelection__"
    }
  },
  "options_ui": {
    "page": "/options/options.html",
    "browser_style": true
  },
  "default_locale": "en",
  "applications": {
    "gecko": {
      "id": "multipletab@piro.sakura.ne.jp",
      "strict_min_version": "139.0"
    }
  }
}
